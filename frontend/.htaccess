<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable directory listing
    Options -Indexes

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map /admin-leads or /admin-leads/ to admin-leads.html
    RewriteCond %{DOCUMENT_ROOT}/admin-leads.html -f
    RewriteRule ^admin-leads/?$ admin-leads.html [L]

    # Map /blogs or /blogs/ to blogs.html
    RewriteCond %{DOCUMENT_ROOT}/blogs.html -f
    RewriteRule ^blogs/?$ blogs.html [L]

    # Map clean URLs to .html files if they exist (e.g. /blog/slug -> /blog/slug.html)
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Fallback to index.html for single page application routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
